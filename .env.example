# --- SendGrid configuration ---
# Create an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# The verified sender address in SendGrid (Single Sender or authenticated domain).
# This is the "from" address; it MUST be verified in your SendGrid account.
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Where the form submissions are delivered.
CONTACT_TO_EMAIL=martin@gtconnections.com
